programa {
  funcao inicio() {

   // Nome: Anderson Pereira Teixeira Filho
   // Disciplina: Lógica de programação
   // Data: 16/09/2026

   real horas
   real vhoras
   real fhoras
   cadeia func


   escreva ("Vamos calcular quanto você vai receber no mês de salário\n")
   escreva ("Qual o nome do funcionário\n")
   leia (func)

   escreva ("Digite quantas horas você trabalhou no mês\n")
   leia (horas)

   escreva ("Quanto você ganha por hora trabalhada\n")
   leia (vhoras)

   fhoras = (horas*vhoras)

   escreva ("O funcionário ", func," vai receber ", fhoras," reais de salário esse mês")
  
    
  }
}
