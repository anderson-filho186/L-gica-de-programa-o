programa {
  funcao inicio() {
    real n1
    real n2

    escreva (" Calculadora\n")

    escreva("Digite n1 ")
    leia (n1)
    escreva ("Digite n2 ")
    leia (n2)
    escreva("\n Todos os Resultados\n")

    escreva("Soma ", n1 + n2, "\n")
    escreva("Subtração", n1 - n2, "\n")
    escreva("Multiplicação", n1 * n2, "\n")
    escreva("Divisão", n1 / n2, ".")

  }
}
