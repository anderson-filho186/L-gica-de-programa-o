programa {
  funcao inicio() {
    // Anderson Pereira Teixeira Filho
    // Lógica de programação
    // 1°c
    // 29/10/2026
     inteiro i, quant

    escreva ("Coloque um número inteiro.\n")
    leia (quant)

    para (i=1; i<=10; i++)
    escreva (quant, " x ", i, " = ", quant * i, "\n")
    
  }
}
