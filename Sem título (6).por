programa {
  funcao inicio() {

    // Nome: Anderson Pereira Teixeira Filho
    // Disciplina: Lógica de programação
    // Data: 16/09/2026
    
    inteiro n1
    inteiro n2
    real n3
    real vfinal

    escreva ("Digite o número 1\n")
    leia (n1)

    escreva ("Agora digite o número 2\n")
    leia (n2)

    n3 = (n1+n2)

    vfinal = (n3*n3)

    escreva ("A soma desses números ao quadrado é igual a ", vfinal,".")
    
  }
}
